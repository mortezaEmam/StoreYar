+++ b/frontend/app/pages/audit.vue
@@ -0,0 +1,50 @@
+<template>
+  <div>
+    <h1>Audit log</h1>
+    <p v-if="!session.businessId" class="warn">Select a business first.</p>
+    <template v-else>
+      <p v-if="error" class="err">{{ error }}</p>
+      <table v-if="items.length">
+        <thead>
+          <tr><th>When</th><th>Action</th><th>Resource</th><th>Actor</th></tr>
+        </thead>
+        <tbody>
+          <tr v-for="(a, i) in items" :key="a.id || i">
+            <td>{{ a.occurred_at || '—' }}</td>
+            <td>{{ a.action || '—' }}</td>
+            <td>{{ a.resource_type }} {{ a.resource_id ? String(a.resource_id).slice(0, 10) + '…' : '' }}</td>
+            <td>{{ a.actor_user_id ? String(a.actor_user_id).slice(0, 10) + '…' : '—' }}</td>
+          </tr>
+        </tbody>
+      </table>
+      <p v-else-if="!loading">No audit entries.</p>
+    </template>
+  </div>
+</template>
+<script setup lang="ts">
+definePageMeta({ middleware: 'auth' })
+const api = useApi()
+const session = useSessionStore()
+const items = ref<any[]>([])
+const loading = ref(false)
+const error = ref('')
+async function load() {
+  if (!session.businessId) return
+  loading.value = true
+  error.value = ''
+  try {
+    const res = await api.get<any>('/audit-log')
+    items.value = Array.isArray(res.data) ? res.data : []
+  } catch (e: unknown) {
+    error.value = e instanceof Error ? e.message : 'Load failed'
+  } finally {
+    loading.value = false
+  }
+}
+watch(() => session.businessId, load, { immediate: true })
+</script>
+<style scoped>
+.err { color: #b00; } .warn { color: #a60; }
+table { width: 100%; border-collapse: collapse; }
+th, td { text-align: left; border-bottom: 1px solid #eee; padding: .4rem; font-size: .9rem; }
+</style>
diff --git a/frontend/app/pages/members.vue b/frontend/app/pages/members.vue
new file mode 100644
index 0000000..c71988d
--- /dev/null
+++ b/frontend/app/pages/members.vue
@@ -0,0 +1,75 @@
+<template>
+  <div>
+    <h1>Members</h1>
+    <p v-if="!session.businessId" class="warn">Select a business first.</p>
+    <template v-else>
+      <form class="create" @submit.prevent="grant">
+        <input v-model="form.user_id" placeholder="User ID" required />
+        <select v-model="form.role">
+          <option value="member">member</option>
+          <option value="admin">admin</option>
+          <option value="owner">owner</option>
+        </select>
+        <button type="submit">Grant membership</button>
+      </form>
+      <p v-if="error" class="err">{{ error }}</p>
+      <table v-if="items.length">
+        <thead><tr><th>User</th><th>Role</th><th></th></tr></thead>
+        <tbody>
+          <tr v-for="m in items" :key="m.user_id">
+            <td>{{ m.user_id.slice(0, 12) }}… {{ m.email || '' }}</td>
+            <td>{{ m.role }}</td>
+            <td><button type="button" @click="revoke(m.user_id)">Revoke</button></td>
+          </tr>
+        </tbody>
+      </table>
+      <p v-else-if="!loading">No members loaded.</p>
+    </template>
+  </div>
+</template>
+<script setup lang="ts">
+definePageMeta({ middleware: 'auth' })
+const api = useApi()
+const session = useSessionStore()
+const items = ref<{ user_id: string; role: string; email?: string }[]>([])
+const loading = ref(false)
+const error = ref('')
+const form = reactive({ user_id: '', role: 'member' })
+async function load() {
+  if (!session.businessId) return
+  loading.value = true
+  error.value = ''
+  try {
+    const res = await api.get<any>(`/organizations/${session.businessId}/members`)
+    items.value = Array.isArray(res.data) ? res.data : (Array.isArray(res) ? res : [])
+  } catch (e: unknown) {
+    error.value = e instanceof Error ? e.message : 'Load failed'
+  } finally {
+    loading.value = false
+  }
+}
+async function grant() {
+  try {
+    await api.post(`/organizations/${session.businessId}/members`, { ...form })
+    form.user_id = ''
+    await load()
+  } catch (e: unknown) {
+    error.value = e instanceof Error ? e.message : 'Grant failed'
+  }
+}
+async function revoke(userId: string) {
+  try {
+    await api.del(`/organizations/${session.businessId}/members/${userId}`)
+    await load()
+  } catch (e: unknown) {
+    error.value = e instanceof Error ? e.message : 'Revoke failed'
+  }
+}
+watch(() => session.businessId, load, { immediate: true })
+</script>
+<style scoped>
+.create { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
+.err { color: #b00; } .warn { color: #a60; }
+table { width: 100%; border-collapse: collapse; }
+th, td { text-align: left; border-bottom: 1px solid #eee; padding: .4rem; }
+</style>
diff --git a/tests/E2E/CommerceHappyPathTest.php b/tests/E2E/CommerceHappyPathTest.php
new file mode 100644
index 0000000..859ee51
--- /dev/null
+++ b/tests/E2E/CommerceHappyPathTest.php
@@ -0,0 +1,139 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Tests\E2E;
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Routing\Middleware\ThrottleRequests;
+use Illuminate\Routing\Middleware\ThrottleRequestsWithRedis;
+use StoreYar\Modules\Identity\Application\Commands\CreateUser\CreateUserCommand;
+use StoreYar\Modules\Identity\Application\Commands\SetPassword\SetPasswordCommand;
+use StoreYar\Modules\Identity\Domain\Aggregates\User;
+use StoreYar\Shared\Application\Bus\Command\CommandBus;
+use Tests\TestCase;
+
+final class CommerceHappyPathTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        $this->withoutMiddleware([
+            ThrottleRequests::class,
+            ThrottleRequestsWithRedis::class,
+        ]);
+    }
+
+    public function test_full_commerce_path(): void
+    {
+        $commands = $this->app->make(CommandBus::class);
+
+        /** @var User $user */
+        $user = $commands->dispatch(
+            new CreateUserCommand(
+                email: 'e2e-owner@example.com',
+                name: 'E2E Owner',
+            ),
+        );
+        $commands->dispatch(
+            new SetPasswordCommand(
+                userId: (string) $user->id(),
+                password: 'password123',
+            ),
+        );
+
+        $token = $this->postJson('/api/auth/login', [
+            'email' => 'e2e-owner@example.com',
+            'password' => 'password123',
+        ])->assertOk()->json('data.token');
+
+        $orgId = $this->withToken($token)
+            ->postJson('/api/organizations', ['name' => 'E2E Shop'])
+            ->assertCreated()
+            ->json('data.id');
+
+        $productId = $this->withToken($token)
+            ->withHeader('X-Business-Id', $orgId)
+            ->postJson('/api/products', [
+                'name' => 'E2E Product',
+                'sku' => 'E2E-SKU-1',
+                'unit_price_amount' => 2500,
+                'currency' => 'IRR',
+            ])
+            ->assertCreated()
+            ->json('data.id');
+
+        $this->withToken($token)
+            ->withHeader('X-Business-Id', $orgId)
+            ->withHeader('Idempotency-Key', 'e2e-stock-'.uniqid('', true))
+            ->postJson('/api/stock', [
+                'product_id' => $productId,
+                'quantity' => 20,
+            ])
+            ->assertCreated();
+
+        $orderId = $this->withToken($token)
+            ->withHeader('X-Business-Id', $orgId)
+            ->withHeader('Idempotency-Key', 'e2e-order-'.uniqid('', true))
+            ->postJson('/api/orders', [
+                'customer_user_id' => (string) $user->id(),
+                'lines' => [
+                    [
+                        'product_id' => $productId,
+                        'quantity' => 2,
+                        'unit_price_amount' => 2500,
+                        'currency' => 'IRR',
+                    ],
+                ],
+            ])
+            ->assertCreated()
+            ->json('data.id');
+
+        $this->withToken($token)
+            ->withHeader('X-Business-Id', $orgId)
+            ->withHeader('Idempotency-Key', 'e2e-confirm-'.uniqid('', true))
+            ->postJson('/api/orders/'.$orderId.'/confirm')
+            ->assertOk();
+
+        $paymentId = $this->withToken($token)
+            ->withHeader('X-Business-Id', $orgId)
+            ->withHeader('Idempotency-Key', 'e2e-pay-'.uniqid('', true))
+            ->postJson('/api/payments', [
+                'order_id' => $orderId,
+                'amount' => 5000,
+                'currency' => 'IRR',
+            ])
+            ->assertCreated()
+            ->json('data.id');
+
+        $this->withToken($token)
+            ->withHeader('X-Business-Id', $orgId)
+            ->withHeader('Idempotency-Key', 'e2e-pay-ok-'.uniqid('', true))
+            ->postJson('/api/payments/'.$paymentId.'/succeed')
+            ->assertOk();
+
+        $shipmentId = $this->withToken($token)
+            ->withHeader('X-Business-Id', $orgId)
+            ->withHeader('Idempotency-Key', 'e2e-ship-'.uniqid('', true))
+            ->postJson('/api/shipments', [
+                'order_id' => $orderId,
+            ])
+            ->assertCreated()
+            ->json('data.id');
+
+        $this->withToken($token)
+            ->withHeader('X-Business-Id', $orgId)
+            ->withHeader('Idempotency-Key', 'e2e-ship-go-'.uniqid('', true))
+            ->postJson('/api/shipments/'.$shipmentId.'/ship', [
+                'tracking_number' => 'E2E-TRACK-1',
+            ])
+            ->assertOk();
+
+        $this->withToken($token)
+            ->withHeader('X-Business-Id', $orgId)
+            ->getJson('/api/audit-log')
+            ->assertOk();
+    }
+}
