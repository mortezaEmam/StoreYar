+
+        $token = $this->postJson('/api/auth/login', [
+            'email' => $email,
+            'password' => 'password123',
+        ])->assertOk()->json('data.token');
+
+        $orgId = $this->withToken($token)
+            ->postJson('/api/organizations', [
